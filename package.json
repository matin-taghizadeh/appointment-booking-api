    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "mongodb-memory-server": "^10.0.0"
  }
}
