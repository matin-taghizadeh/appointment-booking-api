{
  "name": "appointment-booking-api",
  "version": "1.0.0",
  "description": "Appointment booking REST API with JWT auth, roles, and race-safe double-booking prevention. Node.js, Express, MongoDB.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
